#!/usr/bin/env bash
set -euo pipefail

# Lets the user check off PRs from <run-dir>/list.json in a tmux popup.
# ctrl-o shows the PR under the cursor in the glow viewer pane; ctrl-x shows
# or hides dependency updates (hidden at first). The chosen entries go to
# <run-dir>/selected.json in list order. Exits 1 when nothing was chosen.

usage() {
  echo "usage: gh-review-pick <run-dir> <caller-pane-id>" >&2
}

die() {
  echo "gh-review-pick: $*" >&2
  exit 2
}

# Prints one fzf line per PR, leaving out dependency updates unless
# <run-dir>/show-deps exists.
if [ "${1:-}" = --lines ]; then
  show=false
  [ -e "$2/show-deps" ] && show=true
  jq -r --argjson show "$show" '.[] | select($show or (.dependency | not)) | [
      "\(.repo | sub("/"; "__"))__\(.number)",
      (if .category == "reacted" then "[reacted]" elif .dependency then "[deps]   " elif .untouched then "[new*]   " else "[new]    " end),
      "\(.repo)#\(.number)",
      (.created_at // "" | .[0:10]),
      "@\(.author // "ghost")",
      .title,
      (.labels // [] | map("{\(.)}") | join(" ")),
      (if (.reasons | length) > 0 then "(\(.reasons | join(", ")))" else "" end)
    ] | @tsv' "$2/list.json"
  exit 0
fi

# The popup re-enters this script to run fzf, since display-popup takes a
# single shell-command string.
if [ "${1:-}" = --inside ]; then
  RUN="$2"
  PANE="$3"
  self=$(printf '%q' "$0")
  run=$(printf '%q' "$RUN")
  rm -f "$RUN/show-deps"
  "$0" --lines "$RUN" |
    fzf --multi --layout=reverse --delimiter='\t' --with-nth=2.. --no-sort \
      --track --id-nth=1 \
      --header='Tab: check / Enter: confirm / Esc: cancel / ctrl-o: show description / ctrl-x: toggle [deps]   [new*] = no human review yet' \
      --bind "ctrl-o:execute-silent(tmux-glow-open -t $PANE $run/desc/{1}.md)" \
      --bind "ctrl-x:execute-silent([ -e $run/show-deps ] && rm $run/show-deps || touch $run/show-deps)+reload-sync($self --lines $run)" |
    cut -f1 >"$RUN/picked.txt" || true
  exit 0
fi

RUN="${1:-}"
PANE="${2:-}"
if [ -z "$RUN" ] || [ -z "$PANE" ]; then
  usage
  exit 2
fi
[ -n "${TMUX:-}" ] || die "must be run inside tmux"
[ -s "$RUN/list.json" ] || die "no list.json in $RUN (run gh-review-list first)"
RUN=$(cd "$RUN" && pwd)

: >"$RUN/picked.txt"
tmux display-popup -E -w 90% -h 60% -T ' gh-review: pick PRs ' \
  "$(printf '%q ' "$0" --inside "$RUN" "$PANE")"

jq --rawfile picked "$RUN/picked.txt" '
  ($picked | split("\n") | map(select(. != ""))) as $keys
  | map(select(("\(.repo | sub("/"; "__"))__\(.number)") as $k | $keys | index($k)))
' "$RUN/list.json" >"$RUN/selected.json"

count=$(jq length "$RUN/selected.json")
[ "$count" -gt 0 ] || exit 1
echo "$count PRs selected"
