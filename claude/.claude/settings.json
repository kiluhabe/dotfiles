{
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/dotfiles/claude/.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh answering"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh working"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/nudge-agent-tier.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/txdf-follow-worktree.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/audit-log.sh claude"
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh answering"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh idle"
          }            
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "browser-use@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "bigquery-data-analytics@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "rubygems.org",
        "proxy.golang.org",
        "sum.golang.org",
        "crates.io",
        "*.crates.io"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches"
      ]
    },
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "gcloud *",
      "tmux-editor-open *",
      "hunk session *",
      "tmux-glow-open *"
    ]
  },
  "effortLevel": "medium",
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/"
  }
}
