#!/usr/bin/env bash
set -euo pipefail

if [ -z "${TMUX:-}" ]; then
  echo "tmux-worktree-attach-window: must be run inside tmux" >&2
  exit 1
fi

SELECTED=$(tmux-worktree-pick)

if [ -z "$SELECTED" ]; then
  exit 0
fi

WORKTREE_PATH="$SELECTED"
NAME=$(basename "$WORKTREE_PATH")

MATCH=$(tmux list-windows -a -F '#{session_name}:#{window_index} #{pane_current_path}' \
  | awk -v p="$WORKTREE_PATH" '$2 == p { print $1; exit }')

if [ -n "$MATCH" ]; then
  SESSION="${MATCH%%:*}"
  tmux select-window -t "$MATCH"
  tmux switch-client -t "$SESSION"
else
  tmux new-window -c "$WORKTREE_PATH" -n "$NAME"
fi
