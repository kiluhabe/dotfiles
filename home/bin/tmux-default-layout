#!/usr/bin/env bash
set -euo pipefail

EXPLICIT_NAME="${1:-}"
SESSION="${EXPLICIT_NAME:-dev}"
DIR="${2:-$PWD}"

# Builds the layout around $1 (the pane that becomes the watch pane) and
# leaves the cursor in the top-left working pane.
layout() {
  local WATCH="$1"
  local TL R BL
  TL=$(tmux split-window -h -t "$WATCH" -l 90% -c "$DIR" -P -F '#{pane_id}')
  R=$(tmux split-window -h -t "$TL" -c "$DIR" -P -F '#{pane_id}')
  BL=$(tmux split-window -v -t "$TL" -c "$DIR" -P -F '#{pane_id}')

  tmux set-option -p -t "$WATCH" @tmux-default-layout-role watch
  tmux set-option -p -t "$TL" @tmux-default-layout-role agent
  tmux set-option -p -t "$R" @tmux-default-layout-role editor
  tmux set-option -p -t "$BL" @tmux-default-layout-role shell

  tmux send-keys -t "$WATCH" 'agent-watch' Enter
  tmux send-keys -t "$R" '$EDITOR .' Enter
  : "$BL"

  tmux select-pane -t "$TL"
}

if [ -n "${TMUX:-}" ]; then
  # Inside tmux: lay out the current window; don't create or attach a session.
  if [ "$(tmux display-message -p '#{window_panes}')" -gt 1 ]; then
    echo "window is already split" >&2
    exit 1
  fi
  layout "$(tmux display-message -p '#{pane_id}')"
  exit 0
fi

if [ -n "$EXPLICIT_NAME" ]; then
  # Explicit name: attach to the existing session if any.
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach -t "$SESSION"
  fi
else
  # No name given: always start a new session by finding a free suffix.
  i=2
  while tmux has-session -t "$SESSION" 2>/dev/null; do
    SESSION="dev-${i}"
    i=$((i + 1))
  done
fi

layout "$(tmux new-session -d -x "$(tput cols)" -y "$(tput lines)" -s "$SESSION" -c "$DIR" -P -F '#{pane_id}')"
exec tmux attach -t "$SESSION"
