#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: tmux-editor-open <file>" >&2
}

if [ -z "${TMUX:-}" ]; then
  echo "tmux-editor-open: must be run inside tmux" >&2
  exit 1
fi

FILE="${1:-}"
if [ -z "$FILE" ]; then
  usage
  exit 2
fi

EDITOR_BIN="${AGENT_EDITOR:-nvim}"
if ! command -v "$EDITOR_BIN" >/dev/null 2>&1; then
  echo "tmux-editor-open: editor '$EDITOR_BIN' not found in PATH" >&2
  exit 1
fi

case "$FILE" in
  /*) ABS_FILE="$FILE" ;;
  *) ABS_FILE="$PWD/$FILE" ;;
esac

# The pane tagged by tmux-default-layout as the editor pane, in this window only.
# Anchor to $TMUX_PANE (the pane this process actually runs in), not the
# client's current window -- the user may be looking at a different window.
SELF_PANE="${TMUX_PANE:?tmux-editor-open: TMUX_PANE is not set}"
PANE=$(tmux list-panes -t "$SELF_PANE" -F '#{pane_id} #{@tmux-default-layout-role}' \
  | awk -v r=editor '$2 == r { print $1; exit }')

if [ -z "$PANE" ]; then
  PANE=$(tmux split-window -h -t "$SELF_PANE" -c "$PWD" -P -F '#{pane_id}')
  tmux set-option -p -t "$PANE" @tmux-default-layout-role editor
  tmux send-keys -t "$PANE" -l "$EDITOR_BIN '$ABS_FILE'"
  tmux send-keys -t "$PANE" Enter
  exit 0
fi

CURRENT_CMD=$(tmux display-message -p -t "$PANE" '#{pane_current_command}')

if [ "$CURRENT_CMD" != "$EDITOR_BIN" ]; then
  tmux send-keys -t "$PANE" -l "$EDITOR_BIN '$ABS_FILE'"
  tmux send-keys -t "$PANE" Enter
  exit 0
fi

# Editor is already running in the pane: tell it to open the file via :e,
# routed through fnameescape so paths with spaces/special chars survive.
VIM_ESCAPED=$(printf '%s' "$ABS_FILE" | sed "s/'/''/g")
tmux send-keys -t "$PANE" Escape
tmux send-keys -t "$PANE" -l ":execute \"edit \" . fnameescape('$VIM_ESCAPED')"
tmux send-keys -t "$PANE" Enter
