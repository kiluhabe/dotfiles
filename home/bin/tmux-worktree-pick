#!/usr/bin/env bash
set -euo pipefail

# Prints the path of the git worktree picked with fzf; prints nothing when the
# picker is cancelled. The main checkout is the first entry.

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf not found" >&2
  exit 1
fi

git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10) }
  /^branch /   { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
  /^detached$/ { branch = "(detached)" }
  /^$/         { if (path != "") print path "\t" branch; path = ""; branch = "" }
  END          { if (path != "") print path "\t" branch }
' | fzf --with-nth 2,1 --delimiter '\t' --preview 'git -C {1} log -n 5 --oneline' | cut -f1 || true
