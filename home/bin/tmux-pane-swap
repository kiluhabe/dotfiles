#!/usr/bin/env bash
set -euo pipefail

# Toggles the shared slot between two of its roles: shows <role> unless it is
# already on screen, in which case shows <other>. See tmux-pane-show.

usage() {
  echo "usage: tmux-pane-swap <role> <other> [pane]" >&2
}

if [ -z "${TMUX:-}" ]; then
  echo "tmux-pane-swap: must be run inside tmux" >&2
  exit 1
fi

ROLE_A="${1:-}"
ROLE_B="${2:-}"
# run-shell exports TMUX but not TMUX_PANE, so key bindings pass the pane in as
# an argument; an interactive shell has TMUX_PANE and can leave it off.
PANE="${3:-${TMUX_PANE:-}}"
if [ -z "$ROLE_A" ] || [ -z "$ROLE_B" ] || [ -z "$PANE" ]; then
  usage
  exit 2
fi

WINDOW=$(tmux display-message -p -t "$PANE" '#{window_id}')

A_ON_SCREEN=$(tmux list-panes -t "$WINDOW" \
  -F '#{@tmux-default-layout-role}|#{@tmux-default-layout-home}' \
  | awk -F'|' -v role="$ROLE_A" -v home="$WINDOW" '$1 == role && $2 == home { print 1; exit }')

if [ -n "$A_ON_SCREEN" ]; then
  exec tmux-pane-show "$ROLE_B" "$PANE"
fi
exec tmux-pane-show "$ROLE_A" "$PANE"
