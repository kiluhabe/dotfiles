{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh answering",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh working",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/guard-bash.sh",
            "timeout": 30,
            "statusMessage": "Checking Bash command"
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/nudge-bash.sh",
            "timeout": 30,
            "statusMessage": "Checking Bash command usage"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/audit-log.sh codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/context-economy.sh",
            "timeout": 30,
            "statusMessage": "Checking context economy"
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh answering",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-watch-state.sh idle",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
